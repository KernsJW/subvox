<Window x:Class="Subvox.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subvox · Aeropex Whisper Dictation"
        Width="980" Height="700" MinWidth="820" MinHeight="590"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Subvox" FontFamily="Segoe UI Semibold" FontSize="30" />
                <TextBlock Text="Quiet voice, local transcription" Margin="0,4,0,0"
                           FontSize="15" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource AccentDarkBrush}"
                    BorderBrush="#2B6A64" BorderThickness="1" CornerRadius="14"
                    Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="LOCAL WHISPER" Foreground="{StaticResource AccentBrush}"
                           FontFamily="Segoe UI Semibold" FontSize="12" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#102A35" BorderBrush="#245264" BorderThickness="1"
                CornerRadius="8" Padding="14,11" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#7F8DA1"
                         Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Checking your microphone and local model…"
                           FontSize="14" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Input" FontFamily="Segoe UI Semibold" FontSize="18" />
                    <TextBlock Text="Aeropex is selected automatically when Windows exposes its headset microphone."
                               Margin="0,6,0,14" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="InputDeviceBox"
                                  AutomationProperties.Name="Microphone input">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#172232" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="RefreshDevicesButton" Grid.Column="1" Content="↻"
                                Margin="8,0,0,0" Padding="12,8" ToolTip="Refresh microphones"
                                Click="RefreshDevicesButton_Click"
                                AutomationProperties.Name="Refresh microphones" />
                    </Grid>

                    <TextBlock Text="INPUT LEVEL" Margin="0,18,0,7" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" FontFamily="Segoe UI Semibold" />
                    <ProgressBar x:Name="InputLevelBar" Height="8" Minimum="0" Maximum="100"
                                 Background="#0A111B" Foreground="{StaticResource AccentBrush}" />

                    <Separator Margin="0,20" Background="{StaticResource CardBorderBrush}" />

                    <TextBlock Text="Speech model" FontFamily="Segoe UI Semibold" FontSize="16" />
                    <TextBlock x:Name="ModelStatusText" Text="Checking base.en…" Margin="0,5,0,12"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                    <Button x:Name="DownloadModelButton" Content="Download local model"
                            Click="DownloadModelButton_Click" />

                    <Button x:Name="RecordButton" Content="Start whispering  ·  F8"
                            Margin="0,24,0,0" Padding="18,13"
                            Background="#1E6B63" BorderBrush="#3BAE9F"
                            FontSize="15" Click="RecordButton_Click"
                            AutomationProperties.Name="Start or stop whisper recording" />
                    <TextBlock x:Name="TimerText" Text="00:00" HorizontalAlignment="Center"
                               Margin="0,9,0,0" Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Consolas" FontSize="13" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Transcript" FontFamily="Segoe UI Semibold" FontSize="18" />
                            <TextBlock Text="Stop recording to transcribe locally."
                                       Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Copy" Margin="8,0,0,0" Padding="14,7"
                                Click="CopyButton_Click" />
                        <Button Grid.Column="2" Content="Clear" Margin="8,0,0,0" Padding="14,7"
                                Click="ClearButton_Click" />
                    </Grid>

                    <TextBox x:Name="TranscriptBox" Grid.Row="1" Margin="0,16,0,14"
                             Background="{StaticResource ControlBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource CardBorderBrush}"
                             BorderThickness="1" Padding="14" FontSize="17"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             SpellCheck.IsEnabled="True"
                             AutomationProperties.Name="Whisper transcript" />

                    <Border Grid.Row="2" Background="#0E1723" CornerRadius="7" Padding="12,9">
                        <TextBlock Text="Audio stays on this PC. Internet is used only when downloading the Whisper base.en model."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Margin="2,14,0,0" FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Aeropex uses bone conduction for playback; dictation comes from its ordinary Bluetooth headset microphone (HFP)." />
    </Grid>
</Window>
